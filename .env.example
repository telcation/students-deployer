# 本番サーバーの値をコピーして .env を作成してください
# .env はGitにコミットしません

# Flask シークレットキー
STUDENTS_SECRET_KEY=your-secret-key-here
ADMIN_SECRET_KEY=your-admin-secret-key-here

# LINE通知（不要な場合は空のまま）
LINE_NOTIFY_ENABLED=0
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
LINE_NOTIFY_PREFIX=【公開完了通知】

# ポート設定
PORT=5003

# DB パス（ローカル開発時は省略可・デフォルトはプロジェクト直下）
# REQUESTS_DB_PATH=/path/to/requests.db