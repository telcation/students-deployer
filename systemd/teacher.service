# /etc/systemd/system/teacher.service
[Unit]
Description=Teacher App (Production)
After=network.target

[Service]
User=appuser
WorkingDirectory=/home/appuser/students_deployer
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/appuser/students_deployer
Environment=PORT=5000
Environment=SECRET_KEY=400b0b33c34091aacc03262ea960a5eb5d2f280a4b3dbca471e9222f90c02dac
Environment=PURGE_KEY=purge
Environment=RESET_KEY=reset
# 練習用GitHubアカウント初期化用PAT（delete_repoスコープ、各アカウント自身が発行）
# 下記の ghp_xxxxxxxxxxxx を実際のトークン値に置き換えてください
Environment=GITHUB_PAT_USER01_PRACTICE=ghp_
Environment=GITHUB_PAT_USER02_PRACTICE=ghp_
Environment=GITHUB_PAT_USER03_PRACTICE=ghp_
Environment=GITHUB_PAT_USER04_PRACTICE=ghp_
Environment=GITHUB_PAT_USER05_PRACTICE=ghp_
Environment=GITHUB_PAT_USER06_PRACTICE=ghp_
Environment=GITHUB_PAT_USER07_PRACTICE=ghp_
Environment=GITHUB_PAT_USER08_PRACTICE=ghp_
Environment=GITHUB_PAT_USER09_PRACTICE=ghp_
Environment=GITHUB_PAT_USER10_PRACTICE=ghp_
Environment=GITHUB_PAT_USER11_PRACTICE=ghp_
Environment=GITHUB_PAT_USER12_PRACTICE=ghp_
Environment=GITHUB_PAT_USER13_PRACTICE=ghp_
Environment=GITHUB_PAT_USER14_PRACTICE=ghp_
Environment=GITHUB_PAT_USER15_PRACTICE=ghp_
ExecStart=/home/appuser/students_deployer/venv/bin/python /home/appuser/students_deployer/teacher_app.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
